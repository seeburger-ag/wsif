<?xml version="1.0" encoding="UTF-8"?>
<definitions name="SchemaTest1"
    targetNamespace="http://types.wsiftest/"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:tns="http://types.wsiftest/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <types>
        <schema attributeFormDefault="qualified"
            elementFormDefault="qualified"
            targetNamespace="http://types.wsiftest/"
            xmlns="http://www.w3.org/2001/XMLSchema"
            xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/"
            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd1="http://types.wsiftest/">
            <complexType name="ArrayOfInt">
                <complexContent>
                    <restriction base="soapenc:Array">
                        <sequence/>
                        <attribute ref="soapenc:arrayType" wsdl:arrayType="int[]"/>
                    </restriction>
                </complexContent>
            </complexType>
            <complexType name="ArrayOfLong">
                <complexContent>
                    <restriction base="soapenc:Array">
                        <sequence/>
                        <attribute ref="soapenc:arrayType" wsdl:arrayType="long[][]"/>
                    </restriction>
                </complexContent>
            </complexType>
            <complexType name="ArrayOfArrayOfAddress">
                <complexContent>
                    <restriction base="soapenc:Array">
                        <attribute ref="soapenc:arrayType" wsdl:arrayType="xsd1:ArrayOfAddress[]"/>
                    </restriction>
                </complexContent>
            </complexType>            
            <complexType name="ArrayOfAddress">
                <complexContent>
					<restriction base="soapenc:Array">
						<sequence>
							<element name="addr" type="xsd1:address" maxOccurs="unbounded"/>
						</sequence>
					</restriction>
				</complexContent>
            </complexType>
            <complexType name="address">
        		<element name="streetNum" type="xsd:int"/>
        		<element name="streetName" type="xsd:string"/>
        		<element name="city" type="xsd:string"/>
        		<element name="state" type="xsd:string"/>
        		<element name="zip" type="xsd:int"/>
        		<element name="phoneNumber" type="xsd1:phone"/>
      		</complexType>
      		<complexType name="phone">
        		<element name="areaCode" type="xsd:int"/>
		        <element name="exchange" type="xsd:string"/>
		        <element name="number" type="xsd:string"/>
	        </complexType>
			<element name="InfoRequest">
			    <complexType />
            </element>
            <element name="InfoResponse">
                <complexType>
                    <sequence>
                        <element minOccurs="0" maxOccurs="1" name="data" type="xsd:string" />
                    </sequence>
                </complexType>
            </element>
            <element name="addresses" type="xsd1:ArrayOfAddress" />			
        </schema>
    </types>
    
    <message name="testRequest">
        <part name="ints" type="tns:ArrayOfInt"/>
        <part name="longs" type="tns:ArrayOfLong"/>
        <part name="shorts" type="xsd:short"/>
        <part name="byte" type="xsd:byte"/>
    </message>
    <message name="testResponse">
        <part name="result" type="xsd:string"/>
    </message>
    
    <portType name="TestPortType">
        <operation name="runTest" parameterOrder="ints longs shorts byte">
            <input message="tns:testRequest" name="testRequest"/>
            <output message="tns:testResponse" name="testResponse"/>
        </operation>
    </portType>
    
</definitions>
