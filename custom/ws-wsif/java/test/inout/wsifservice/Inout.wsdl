      <output name="WhoamiIntResponse" 
              message="tns:WhoamiIntResponseMessage"/>
    </operation>
    <operation name="whoami">
      <input name="WhoamiAddressRequest" 
             message="tns:WhoamiAddressRequestMessage"/>
      <output name="WhoamiAddressResponse" 
              message="tns:WhoamiAddressResponseMessage"/>
    </operation>
