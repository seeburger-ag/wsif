<?xml version="1.0" ?>

<definitions targetNamespace="http://wsifservice.inout/"
             xmlns:tns="http://wsifservice.inout/"
             xmlns:typeabns="http://wsiftypes.addressbook/"
             xmlns:typeions="http://wsiftypes.inout/"
             xmlns:xsd="http://www.w3.org/1999/XMLSchema"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:jms="http://schemas.xmlsoap.org/wsdl/jms/"
             xmlns:format="http://schemas.xmlsoap.org/wsdl/formatbinding/"
             xmlns:java="http://schemas.xmlsoap.org/wsdl/java/"
             xmlns="http://schemas.xmlsoap.org/wsdl/">

  <!-- type defs -->
  <types>
    <xsd:schema
      targetNamespace="http://wsiftypes.addressbook/"
                xmlns:xsd="http://www.w3.org/1999/XMLSchema">
      <xsd:complexType name="phone">
        <xsd:element name="areaCode" type="xsd:int"/>
        <xsd:element name="exchange" type="xsd:string"/>
        <xsd:element name="number" type="xsd:string"/>
      </xsd:complexType>

      <xsd:complexType name="address">
        <xsd:element name="streetNum" type="xsd:int"/>
        <xsd:element name="streetName" type="xsd:string"/>
        <xsd:element name="city" type="xsd:string"/>
        <xsd:element name="state" type="xsd:string"/>
        <xsd:element name="zip" type="xsd:int"/>
        <xsd:element name="phoneNumber" type="typeabns:phone"/>
      </xsd:complexType>
    </xsd:schema>
    <xsd:schema
      targetNamespace="http://wsiftypes.inout/"
                xmlns:xsd="http://www.w3.org/1999/XMLSchema">
      <xsd:complexType name="mutablestring">
        <xsd:element name="str" type="xsd:string"/>
      </xsd:complexType>
    </xsd:schema>
  </types>

  <!-- message declns -->
  <message name="AddEntryWholeNameRequestMessage">
    <part name="name" type="xsd:string"/>
    <part name="address" type="typeabns:address"/>
  </message>

  <message name="AddEntryFirstAndLastNamesRequestMessage">
    <part name="firstName" type="xsd:string"/>
    <part name="lastName" type="xsd:string"/>
    <part name="address" type="typeabns:address"/>
  </message>

  <message name="GetAddressFromNameRequestMessage">
    <part name="name" type="xsd:string"/>
  </message>

  <message name="GetAddressFromNameMSRequestMessage">
    <part name="name" type="typeions:mutablestring"/>
  </message>

  <message name="GetAddressFromNameResponseMessage">
    <part name="address" type="typeabns:address"/>
  </message>

  <message name="GetAddressFromNameMSARequestMessage">
    <part name="name" type="typeions:mutablestring"/>
    <part name="address" type="typeabns:address"/>
  </message>

  <message name="GetAddressFromNameMSAResponseMessage">
    <part name="success" type="xsd:boolean"/>
    <part name="address" type="typeabns:address"/>
  </message>

  <message name="AddNumbersRequestMessage">
    <part name="nums" type="typeions:arrayofint"/>
  </message>

  <message name="AddNumbersResponseMessage">
    <part name="total" type="xsd:int"/>
  </message>

  <message name="GetDateRequestMessage">
  </message>

  <message name="GetDateResponseMessage">
    <part name="date" type="xsd:timeInstant"/>
  </message>

  <message name="WhoamiStringRequestMessage">
    <part name="string" type="xsd:string"/>
  </message>

  <message name="WhoamiStringResponseMessage">
    <part name="type" type="xsd:string"/>
  </message>

  <message name="WhoamiFloatRequestMessage">
    <part name="float" type="xsd:float"/>
  </message>

  <message name="WhoamiFloatResponseMessage">
    <part name="type" type="xsd:string"/>
  </message>

  <message name="WhoamiIntRequestMessage">
    <part name="int" type="xsd:int"/>
  </message>

  <message name="WhoamiIntResponseMessage">
    <part name="type" type="xsd:string"/>
  </message>

  <message name="WhoamiAddressRequestMessage">
    <part name="address" type="typeabns:address"/>
  </message>

  <message name="WhoamiAddressResponseMessage">
    <part name="type" type="xsd:string"/>
  </message>

  <!-- port type declns -->
  <portType name="Inout">
    <operation name="addEntry">
      <input name="AddEntryWholeNameRequest" 
             message="tns:AddEntryWholeNameRequestMessage"/>
    </operation>
    <operation name="addEntry">
      <input name="AddEntryFirstAndLastNamesRequest" 
             message="tns:AddEntryFirstAndLastNamesRequestMessage"/>
    </operation>
    <operation name="getAddressFromName">
      <input name="GetAddressFromNameRequest" 
             message="tns:GetAddressFromNameRequestMessage"/>
      <output name="GetAddressFromNameResponse" 
              message="tns:GetAddressFromNameResponseMessage"/>
    </operation>
    <operation name="getAddressFromName">
      <input name="GetAddressFromNameMSRequest" 
             message="tns:GetAddressFromNameMSRequestMessage"/>
      <output name="GetAddressFromNameMSResponse" 
              message="tns:GetAddressFromNameResponseMessage"/>
    </operation>
    <operation name="getAddressFromName">
      <input name="GetAddressFromNameMSARequest" 
             message="tns:GetAddressFromNameMSARequestMessage"/>
      <output name="GetAddressFromNameMSAResponse" 
              message="tns:GetAddressFromNameMSAResponseMessage"/>
    </operation>
    <operation name="addNumbers">
      <input name="AddNumbersRequest" 
             message="tns:AddNumbersRequestMessage"/>
      <output name="AddNumbersResponse" 
