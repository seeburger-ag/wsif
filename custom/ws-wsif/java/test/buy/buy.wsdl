<?xml version="1.0" encoding="UTF-8"?>
<!-- ===========================================================
Hand-crafted version for HTTPR and JMS transports.

Future versions may be generated by application development tools.

This file relies on two different bindings definied in buy-interface.wsdl:
    buyServiceBindingSoapHTTPR
    buyServiceBindingSoapJMS
for the HTTPR and JMS transports.

Additionally, it uses different ports to select different
servlet environments for HTTPR.
These use different persistet store implementations.

Because of limitations in the pluggable transport in this version of Axis,
the port definitions cannot be coded in a 'correct' manner.
The location is 'curried' by placing the transport type at the end
of the location after "!!!".
e.g. the HTTPR url
    httpr://localhost:80/httpr/servlet/HttprServerJMS#soapin
is written as    
    http://localhost:80/httpr/servlet/HttprServerJMS#soapin!!!httpr
HTTPRSender translates the URL to the 'correct' form.

These files are held in the local directory of the client.
This is becuase in an JMS environment is is not necessarily the case
that there will be a Web Server available to serve these definitions.
(This is particularly true for some MQSeries test environments.)
============================================================ -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:interface="http://www.buyservice.com/buy-interface" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://www.buyservice.com/buy" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="buyService" targetNamespace="http://www.buyservice.com/buy" xmlns:jms="http://schemas.xmlsoap.org/wsdl/jms">

<import location="buy-interface.wsdl" namespace="http://www.buyservice.com/buy-interface">
</import>

<service name="buyService">
  <documentation>HTTPR Stock Purchase Example</documentation>
  
  <port binding="interface:buyServiceBindingSoapHTTPR" name="HTTPRPort">
    <soap:address location="http://localhost:8080/httpr/servlet/HttprServer#soapin!!!httpr"/>
  </port>

  <port binding="interface:buyServiceBindingSoapHTTPR" name="HTTPRPortJMS">
    <soap:address location="http://localhost:8080/httpr/servlet/HttprServerJMS#soapin!!!httpr"/>
  </port>

  <port binding="interface:buyServiceBindingSoapHTTPR" name="HTTPRPortFile">
    <soap:address location="http://localhost:8080/httpr/servlet/HttprServerFile#soapin!!!httpr"/>
  </port>

  <port binding="interface:buyServiceBindingSoapHTTPR" name="HTTPRPortNoFile">
    <soap:address location="http://localhost:8080/httpr/servlet/HttprServerNoFile#soapin!!!httpr"/>
  </port>

  <port binding="interface:buyServiceBindingSoapHTTPR" name="HTTPRPortDB2">
    <soap:address location="http://localhost:8080/httpr/servlet/HttprServerDB2#soapin!!!httpr"/>
  </port>

  <!-- The current JMSSender implementation does NOT parse this correctly. -->
  <!-- The 'soapin' is hard coded and not read from the location below. -->
  <port binding="interface:buyServiceBindingSoapJMS" name="JMSPort">
    <!--soap:address location="http://localhost:8080/jms#soapin!!!jms"/-->
    <jms:address jndiDestinationName="soapin"
                 destinationStyle="queue"
                 jndiConnectionFactoryName="soapqcf"
                 initialContextFactory="com.sun.jndi.fscontext.RefFSContextFactory"
                 jndiProviderURL="file:///JNDI-Directory"/>
  </port>

</service>

</definitions>