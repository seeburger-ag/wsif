<?xml version="1.0" encoding="UTF-8"?>
<!-- ===========================================================
Hand-crafted version for HTTPR and JMS transports.

Future versions may be generated by application development tools.

This file defines two different bindings:
    buyServiceBindingSoapHTTPR
    buyServiceBindingSoapJMS
for the HTTPR and JMS transports.

As these are not yet official, placeholder transports are defined:
    transport="http://xxx/soap/httpr"
    transport="http://xxx/soap/jms"
These will be replaced as standard versions become available.    
============================================================ -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://www.buyservice.com/buy-interface" xmlns:types="http://www.buyservice.com/buy-types" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="buyService-interface" targetNamespace="http://www.buyservice.com/buy-interface">

<import location="buy.xsd" namespace="http://www.buyservice.com/buy-types">
</import>

<message name="Inbuy">
  <part name="symbol" type="xsd:string"/>
  <part name="amount" type="xsd:int"/>
</message>

<message name="Outbuy">
  <part name="receipt" type="xsd:string"/>
</message>

<portType name="buyService">
  <operation name="buy">
    <input message="tns:Inbuy"/>
    <output message="tns:Outbuy"/>
  </operation>
</portType>

<binding name="buyServiceBindingSoapHTTPR" type="tns:buyService">
  <soap:binding style="rpc" transport="http://xxx/soap/httpr"/>
  <operation name="buy">
    <soap:operation soapAction="http://www.buyservice.com/buy"/>
    <input>
      <soap:body encodingStyle="http://schemas.xmlsoap.org/soap/encoding/" namespace="http://www.buyservice.com/buy" use="encoded"/>
    </input>
    <output>
      <soap:body encodingStyle="http://schemas.xmlsoap.org/soap/encoding/" namespace="http://www.buyservice.com/buy" use="encoded"/>
    </output>
  </operation>
</binding>

<binding name="buyServiceBindingSoapJMS" type="tns:buyService">
  <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/jms"/>
  <operation name="buy">
    <soap:operation soapAction="http://www.buyservice.com/buy"/>
    <input>
      <soap:body encodingStyle="http://schemas.xmlsoap.org/soap/encoding/" namespace="http://www.buyservice.com/buy" use="encoded"/>
    </input>
    <output>
      <soap:body encodingStyle="http://schemas.xmlsoap.org/soap/encoding/" namespace="http://www.buyservice.com/buy" use="encoded"/>
    </output>
  </operation>
</binding>

</definitions>