<isd:service xmlns:isd="http://xml.apache.org/xml-soap/deployment"
             id="http://wsifservice.simpletypes/"
             checkMustUnderstands="false">
  <isd:provider type="java"
                scope="Application"
                methods="getString getBoolean getFloat getDouble getDecimal getInteger getShort getByte getBase64">
    <isd:java class="simpletypes.wsifservice.SOAPENCSimpleTypes"/>
  </isd:provider>

  <isd:mappings>  
      <isd:map encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
          xmlns:x="http://schemas.xmlsoap.org/soap/encoding/"
          qname="x:string"
          javaType="java.lang.String"/>
      <isd:map encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
          xmlns:x="http://schemas.xmlsoap.org/soap/encoding/"
          qname="x:boolean"
          javaType="java.lang.Boolean" /> 
      <isd:map encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
          xmlns:x="http://schemas.xmlsoap.org/soap/encoding/"
          qname="x:float"
          javaType="java.lang.Float" />
      <isd:map encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
          xmlns:x="http://schemas.xmlsoap.org/soap/encoding/"
          qname="x:double"
          javaType="java.lang.Double" />
      <isd:map encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
          xmlns:x="http://schemas.xmlsoap.org/soap/encoding/"
          qname="x:decimal"
          javaType="java.math.BigDecimal"/>           
      <isd:map encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
          xmlns:x="http://schemas.xmlsoap.org/soap/encoding/"
          qname="x:int"
          javaType="java.lang.Integer" />
      <isd:map encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
          xmlns:x="http://schemas.xmlsoap.org/soap/encoding/"
          qname="x:short"
          javaType="java.lang.Short" />
      <isd:map encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
          xmlns:x="http://schemas.xmlsoap.org/soap/encoding/"
          qname="x:byte"
          javaType="java.lang.Byte" />
      <isd:map encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"
          xmlns:x="http://schemas.xmlsoap.org/soap/encoding/"
          qname="x:base64"
          javaType="[B" />
  </isd:mappings>
            
  <isd:faultListener>org.apache.soap.server.DOMFaultListener</isd:faultListener>
</isd:service>